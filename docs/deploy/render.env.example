# Importar somente no Render (API) e nos segredos de jobs no GitHub Actions.
# O container usa backend/Dockerfile (python:3.11-slim). Preencher os valores vazios.
APP_ENV=production
DATABASE_URL=postgresql+psycopg://postgres.<PROJECT_REF>:<SENHA_URL_ENCODED>@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
# Publishable/anon do MESMO projeto; a chave atual local foi recusada pela nuvem.
SUPABASE_ANON_KEY=
# O cliente Storage atual envia Bearer: usar a service_role JWT legada.
SUPABASE_SERVICE_ROLE_KEY=
CORS_ORIGINS=https://<SEU-FRONTEND>.vercel.app
# OAuth do Google Calendar (segredos somente no backend).
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://<SUA-API>.onrender.com/api/v1/me/google-calendar/callback
GOOGLE_CALENDAR_FRONTEND_REDIRECT_URI=https://<SEU-FRONTEND>.vercel.app/eventos?aba=meus
GOOGLE_TOKEN_ENCRYPTION_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Contingência (fallback) opcional a custo zero (provedores: groq, openrouter :free, mistral).
# Ao habilitar fallback, recomenda-se SYLLABUS_ATTEMPT_TIMEOUT_SECONDS=22 para acomodar
# timeout do primário + chamada do secundário dentro do lease de 90s.
SYLLABUS_FALLBACK_PROVIDER=groq
SYLLABUS_FALLBACK_API_KEY=
SYLLABUS_FALLBACK_MODEL=llama-3.3-70b-versatile
SYLLABUS_FALLBACK_TIMEOUT_SECONDS=8
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_PDF_PAGES=10
SYLLABUS_UPLOAD_VALIDATION_TIMEOUT_SECONDS=8
SYLLABUS_AI_TIMEOUT_SECONDS=12
SYLLABUS_ATTEMPT_TIMEOUT_SECONDS=18
SYLLABUS_MAX_ATTEMPTS=2
SYLLABUS_RATE_LIMIT_DELAY_SECONDS=65
SYLLABUS_MIN_INTERVAL_SECONDS=4.0
SYLLABUS_MAX_FILE_COST_USD=0.06
GEMINI_INPUT_USD_PER_MILLION=0.30
GEMINI_OUTPUT_USD_PER_MILLION=2.50
# Ativar após homologação HTTP e aprovação S7-B02; banco migrado não basta.
SYLLABUS_WORKER_ENABLED=true
SYLLABUS_PRIVACY_READY=true
SYLLABUS_PROVIDER_TERMS_READY=true
