# Frontend Vite na Vercel com API externa no Render (ver frontend/src/lib/deploymentConfig.js).
# As variáveis públicas do Supabase também são usadas pela função de busca (frontend/api/search.js).
VITE_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# Alternativa legada (JWT role=anon), caso não utilize sb_publishable_.
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=https://<SUA-API>.onrender.com/api/v1
