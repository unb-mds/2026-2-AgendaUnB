{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/eventos.html", "destination": "/eventos", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/eventos/", "destination": "/eventos", "permanent": true }
  ],
  "headers": [
    {
      "source": "/auth/retorno",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" },
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/:page(admin|sugestoes|segunda-pagina|plano-de-ensino|app.html)/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/eventos",
      "has": [{ "type": "query", "key": "aba", "value": "meus" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/prototipo-plano-de-ensino/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ],
  "rewrites": [
    { "source": "/_mintlify/:path*", "destination": "https://agenda-un-b.mintlify.site/_mintlify/:path*" },
    { "source": "/api/request", "destination": "https://agenda-un-b.mintlify.site/_mintlify/api/request" },
    { "source": "/docs", "destination": "https://agenda-un-b.mintlify.site/docs" },
    { "source": "/docs/:match*", "destination": "https://agenda-un-b.mintlify.site/docs/:match*" },
    { "source": "/mintlify-assets/:path+", "destination": "https://agenda-un-b.mintlify.site/mintlify-assets/:path+" },
    { "source": "/auth/retorno", "destination": "/app.html" },
    { "source": "/sitemap.xml", "destination": "/api/search?kind=sitemap" },
    { "source": "/evento/:id", "destination": "/api/search?kind=event&id=:id" },
    { "source": "/eventos", "destination": "/eventos.html" },
    { "source": "/:page(admin|sugestoes|segunda-pagina|plano-de-ensino)/:path*", "destination": "/app.html" }
  ]
}
