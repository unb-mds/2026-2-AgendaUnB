{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/search.js": { "includeFiles": "search/app-template.html" }
  },
  "redirects": [
    { "source": "/:page(eventos|calendario-academico|horarios-de-aula).html", "destination": "/:page", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/:page(eventos|calendario-academico|horarios-de-aula)/", "destination": "/:page", "permanent": true }
  ],
  "headers": [
    {
      "source": "/:page(admin|sugestoes|segunda-pagina|plano-de-ensino|app.html)/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/eventos",
      "has": [{ "type": "query", "key": "aba", "value": "meus" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/prototipo-plano-de-ensino/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/search?kind=sitemap" },
    { "source": "/evento/:id", "destination": "/api/search?kind=event&id=:id" },
    { "source": "/:page(eventos|calendario-academico|horarios-de-aula)", "destination": "/:page.html" },
    { "source": "/:page(admin|sugestoes|segunda-pagina|plano-de-ensino)/:path*", "destination": "/app.html" }
  ]
}
