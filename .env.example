# Copie para .env e preencha. O .env NAO vai para o Git.
# Os valores locais aparecem ao rodar 'npx supabase start'.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Credenciais do Google Cloud Console (OAuth) para o login com o Google
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
