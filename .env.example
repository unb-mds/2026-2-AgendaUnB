VITE_API_URL=
# Identifica somente a configuração pública; não concede permissões.
VITE_DEPLOYMENT_ENV=local
# Referências públicas usadas apenas pelo build para bloquear previews compartilhados.
PRODUCTION_SUPABASE_URL=
PRODUCTION_API_ORIGIN=
VITE_SUPABASE_URL=
# Chave publishable (sb_publishable_...), nunca secret/service_role.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Alternativa legada: JWT com role anon.
VITE_SUPABASE_ANON_KEY=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/agenda_unb
APP_ENV=local
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=chave-publica-do-projeto
SUPABASE_SERVICE_ROLE_KEY=
# OAuth adicional do Google Calendar (segredos somente no backend).
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/api/v1/me/google-calendar/callback
GOOGLE_CALENDAR_FRONTEND_REDIRECT_URI=http://localhost:5173/eventos?aba=meus
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_PDF_PAGES=10
# Prazo do parser durante o upload, separado do prazo de processamento da fila.
SYLLABUS_UPLOAD_VALIDATION_TIMEOUT_SECONDS=8
# Apenas no backend/worker. Nunca usar prefixo VITE_ para credenciais.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Contingência (fallback) opcional a custo zero (provedores: groq, openrouter :free, mistral).
# Ao habilitar fallback, recomenda-se SYLLABUS_ATTEMPT_TIMEOUT_SECONDS=22 para acomodar
# timeout do primário + chamada do secundário dentro do lease de 90s.
SYLLABUS_FALLBACK_PROVIDER=groq
SYLLABUS_FALLBACK_API_KEY=
SYLLABUS_FALLBACK_MODEL=llama-3.3-70b-versatile
SYLLABUS_FALLBACK_TIMEOUT_SECONDS=8
SYLLABUS_AI_TIMEOUT_SECONDS=12
SYLLABUS_ATTEMPT_TIMEOUT_SECONDS=22
SYLLABUS_MAX_ATTEMPTS=2
SYLLABUS_MAX_FILE_COST_USD=0.06
# Preços de referência em USD/1M tokens (incluindo raciocínio na saída).
# Revisar junto ao provedor ao trocar modelo/ambiente.
GEMINI_INPUT_USD_PER_MILLION=0.30
GEMINI_OUTPUT_USD_PER_MILLION=2.50
# Ativar somente após migrações e testes de privacidade da S6-D02.
SYLLABUS_WORKER_ENABLED=false
SYLLABUS_PRIVACY_READY=false
# Declaração operacional após evidências de termos/tier/elegibilidade em S7-B02.
SYLLABUS_PROVIDER_TERMS_READY=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ──────────────────────────────────────────────────────────────────────────────
# SMTP — e-mail transacional (confirmação de conta e recuperação de senha)
# Consumido pelo Supabase Auth (GoTrue) no ambiente hospedado.
# Em desenvolvimento local o Supabase usa o Inbucket embutido (porta 14324);
# as variáveis abaixo são ignoradas localmente pelo Supabase CLI.
# ──────────────────────────────────────────────────────────────────────────────
# Host do servidor SMTP (ex.: smtp.mailgun.org, smtp.sendgrid.net)
SMTP_HOST=
# Porta SMTP: 587 para STARTTLS (recomendado) ou 465 para TLS implícito
SMTP_PORT=587
# Usuário de autenticação SMTP (geralmente o e-mail ou "apikey")
SMTP_USER=
# Senha ou chave de API do provedor SMTP — NUNCA commitar o valor real
SMTP_PASS=
# Endereço de remetente exibido ao destinatário (ex.: noreply@agendaunb.unb.br)
SMTP_SENDER_EMAIL=
# Nome exibido como remetente
SMTP_SENDER_NAME=Agenda UnB

# --- Segurança da API (S8-D02). Padrões seguros para desenvolvimento local. ---
# Em homologação/produção: API_DOCS_ENABLED=false e CORS_ORIGINS só com a URL da SPA.
API_DOCS_ENABLED=true
# Requisições por cliente/minuto (0 desliga). Escritas têm teto próprio.
RATE_LIMIT_PER_MINUTE=240
RATE_LIMIT_WRITE_PER_MINUTE=60
# Proxies confiáveis em hospedagem própria. No Render, a API usa CF-Connecting-IP da borda.
TRUSTED_PROXY_HOPS=0
MAX_JSON_BODY_BYTES=262144
